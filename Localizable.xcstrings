    "Connect Tailscale on both devices, paste the Mac's private HTTPS address and approve pairing on the Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Tailscale on both devices, paste the Mac's private HTTPS address and approve pairing on the Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega Tailscale su entrambi i dispositivi, incolla l’indirizzo HTTPS privato del Mac e approva l’associazione sul Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在两个设备上连接 Tailscale，粘贴 Mac 的私有 HTTPS 地址，然后在 Mac 上批准配对。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のデバイスで Tailscale に接続し、Mac のプライベート HTTPS アドレスを貼り付け、Mac でペアリングを承認してください。"
          }
        }
      }
    },
    "remote.error.invalidTailscaleEndpoint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an HTTPS .ts.net address without a path, user, query or fragment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un indirizzo HTTPS .ts.net senza percorso, utente, query o frammento."
          }
        }
      }
    },
    "remote.error.tailscalePairingFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing failed. Check Tailscale, Serve and approval on the Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing non riuscito: verifica Tailscale, Serve e l’approvazione sul Mac."
          }
        }
      }
    },
    "remote.error.identityFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac did not pass the identity check."
          }
