    "The model generated an invalid tool request. No action was performed. Please rephrase and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model generated an invalid tool request. No action was performed. Please rephrase and try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello ha generato una richiesta di strumento non valida. Nessuna azione è stata eseguita. Riformula la richiesta e riprova."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型生成了无效的工具请求。未执行任何操作，请重新表述后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが無効なツール要求を生成しました。操作は実行していません。言い換えて再試行してください。"
          }
        }
      }
    },
    "The model did not return a usable response. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model did not return a usable response. Please try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello non ha restituito una risposta valida. Riprova."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型未返回有效回复，请重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルから有効な応答がありませんでした。再試行してください。"
          }
        }
      }
    },
    "Cannot divide by zero.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile dividere per zero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能除以零。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゼロで割ることはできません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot divide by zero."
          }
        }
      }
    },
    "This calculation exceeds the local calculator's precision or numeric limits.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo calcolo supera la precisione o i limiti numerici del calcolatore locale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此计算超出了本地计算器的精度或数值范围。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この計算はローカル計算機の精度または数値範囲を超えています。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This calculation exceeds the local calculator's precision or numeric limits."
          }
        }
      }
    }
